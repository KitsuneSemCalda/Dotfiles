# `perl scripts/docker-stack.pl --up` creates docker/.env automatically with
# random secrets on first run. This file only documents the available
# variables; edit docker/.env (outside git) to customize.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# --- Redis ---
REDIS_PASSWORD=

# --- FrankMD ---
# Absolute path; the script creates the directory if it doesn't exist.
FRANKMD_NOTES_DIR=
FRANKMD_SECRET_KEY_BASE=
FRANKMD_AUTH_TOKEN=

# --- Pi-hole ---
TZ=America/Sao_Paulo
PIHOLE_PASSWORD=

# --- ai-memory (optional; memory works with no keys configured) ---
AI_MEMORY_LLM_PROVIDER=
ANTHROPIC_API_KEY=
AI_MEMORY_EMBEDDING_PROVIDER=
OPENAI_API_KEY=
