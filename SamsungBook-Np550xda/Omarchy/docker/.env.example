# `perl scripts/docker-stack.pl --up` cria docker/.env automaticamente com
# segredos aleatórios na primeira execução. Este arquivo só documenta as
# variáveis disponíveis; edite docker/.env (fora do git) para customizar.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# --- Redis ---
REDIS_PASSWORD=

# --- FrankMD ---
# Caminho absoluto; o script cria o diretório se não existir.
FRANKMD_NOTES_DIR=
FRANKMD_SECRET_KEY_BASE=
FRANKMD_AUTH_TOKEN=

# --- Pi-hole ---
TZ=America/Sao_Paulo
PIHOLE_PASSWORD=

# --- ai-memory (opcionais; a memória funciona sem nenhuma chave configurada) ---
AI_MEMORY_LLM_PROVIDER=
ANTHROPIC_API_KEY=
AI_MEMORY_EMBEDDING_PROVIDER=
OPENAI_API_KEY=
