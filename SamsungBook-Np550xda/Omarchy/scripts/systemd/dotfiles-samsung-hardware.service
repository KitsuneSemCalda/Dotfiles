[Unit]
Description=Enforce and verify SamsungBook battery and hardware policy
After=systemd-modules-load.service
# Power Profiles starts after multi-user.target; it cannot gate this early unit.
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/modprobe samsung_galaxybook
ExecStart=/usr/local/libexec/dotfiles-samsung-hardware
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
