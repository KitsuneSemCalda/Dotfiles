#!/usr/bin/env bash
set -euo pipefail

[[ $EUID == 0 && $# == 1 ]] || { echo 'Usage (as root): btrfs-monthly-backup HOME' >&2; exit 2; }
home=$(realpath -e -- "$1")
[[ $home == /home/* && $(findmnt -n -o FSTYPE -T /) == btrfs ]] || {
  echo 'Expected a /home user on Btrfs' >&2; exit 1;
}
owner=$(stat -c %U -- "$home")
[[ $owner != root && $owner != UNKNOWN ]] || { echo 'Invalid home owner' >&2; exit 1; }

date=$(date +%F)
month=${date:0:7}
year=${date:0:4}
state=/var/lib/home-dropbox-backup
snapshots="$state/snapshots"
destination="$home/.local/state/home-dropbox-backup/archives/btrfs"
helper=/usr/local/libexec/dotfiles-backup-zip
work="$home/.local/state/home-dropbox-backup/btrfs"
install -d -m 0700 -- "$snapshots"
exec 9>"$state/lock"
flock -w 3600 9 || { echo 'Timed out waiting for Btrfs export' >&2; exit 1; }
runuser -u "$owner" -- mkdir -p -- "$destination/$year" "$work"
resolved_destination=$(realpath -e -- "$destination")
[[ $resolved_destination != "$home/Dropbox" && $resolved_destination != "$home/Dropbox"/* ]] || {
  echo 'Btrfs archives must be outside Dropbox' >&2; exit 1;
}
runuser -u "$owner" -- env TMPDIR="$work" python3 "$helper" consolidate "$destination" --year "$year"
shopt -s nullglob
existing=("$destination/$year/$month"-??.zip)
if ((${#existing[@]})); then
  valid=true
  for archive in "${existing[@]}"; do
    if ! runuser -u "$owner" -- python3 "$helper" verify "$archive" --btrfs; then
      valid=false
      quarantine=$(runuser -u "$owner" -- mktemp -d -- "$work/incomplete.XXXXXXXX")
      runuser -u "$owner" -- mv -- "$archive" "$quarantine/"
      echo "Preserved corrupt Btrfs ZIP in $quarantine; retrying $month" >&2
    fi
  done
  if [[ $valid == true ]]; then
    echo "Btrfs ZIP already verified: ${existing[0]}"
    exit 0
  fi
fi

snapshot="$snapshots/$month"
[[ -e $snapshot ]] || btrfs subvolume snapshot -r / "$snapshot"
available_kib=$(df -Pk -- "$destination" | awk 'NR == 2 { print $4 }')
source_kib=$(du -skx --exclude=/.snapshots --exclude=/var/lib/home-dropbox-backup / | awk '{ print $1 }')
(( available_kib >= source_kib * 2 + 10 * 1024 * 1024 )) || {
  echo 'Insufficient free space for a full Btrfs ZIP and 10 GiB reserve' >&2; exit 1;
}

temporary=$(runuser -u "$owner" -- mktemp -- "$work/snapshot.XXXXXXXX.zip")
runuser -u "$owner" -- rm -- "$temporary"
cleanup() { runuser -u "$owner" -- rm -f -- "$temporary"; }
trap cleanup EXIT
# A full stream makes each month's backup independently restorable, including
# after annual consolidation. Publish only after the producer also succeeds.
btrfs send "$snapshot" \
  | runuser -u "$owner" -- env TMPDIR="$work" python3 "$helper" stream "$temporary"
runuser -u "$owner" -- python3 "$helper" verify "$temporary" --btrfs
runuser -u "$owner" -- mv -- "$temporary" "$destination/$year/$date.zip"
for old in "$snapshots"/????-??; do
  [[ ! -d $old ]] || btrfs subvolume delete -- "$old"
done
echo "Created local full Btrfs ZIP: $destination/$year/$date.zip"
