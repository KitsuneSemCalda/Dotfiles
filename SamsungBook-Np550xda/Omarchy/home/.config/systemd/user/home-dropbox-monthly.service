[Unit]
Description=Save local monthly HOME ZIPs and publish budgeted cloud essentials
ConditionPathIsDirectory=%h/Dropbox
Wants=home-dropbox-backup.service
After=home-dropbox-backup.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/home-dropbox-monthly
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
