[Unit]
Description=Enforce and verify SamsungBook energy and audio session policy
PartOf=graphical-session.target
After=graphical-session.target pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/enforce-samsung-session
TimeoutStartSec=90

[Install]
WantedBy=graphical-session.target
