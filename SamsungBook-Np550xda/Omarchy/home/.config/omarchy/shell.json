{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "kitsuneforgering.glass"
        },
        {
          "dynamicWidth": true,
          "id": "omarchy.media",
          "showArtist": false,
          "showIcon": false,
          "showTitle": false
        },
        {
          "id": "tornikegomareli.spaces",
          "density": "normal",
          "iconSize": 16,
          "labelStyle": "number",
          "previewSize": "large",
          "showApps": "hover"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.kitsunesemcalda.feader-rss"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "kitsuneforgering.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": true,
    "id": "kitsuneforgering.glass"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "kitsuneforgering.glass"
    }
  ],
  "version": 1
}
