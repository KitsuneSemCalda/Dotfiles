#!/usr/bin/env python3
"""Guided setup for connected hardware. No automatic gain or color guesses."""
import argparse
import json
import math
from pathlib import Path
import select
import shutil
import subprocess
import sys

HOME = Path.home()
ROOT = HOME / '.config/dotfiles-hardware'


def run(*args):
    subprocess.run(args, check=True)


def query(*args):
    result = subprocess.run(args, text=True, capture_output=True, check=True)
    return json.loads(result.stdout)


def inventory():
    report = {}
    for key, command in {
        'monitors': ['hyprctl', 'monitors', 'all', '-j'],
        'input': ['hyprctl', 'devices', '-j'],
        'audio': ['wpctl', 'status', '-n'],
        'video': ['v4l2-ctl', '--list-devices'],
        'usb': ['lsusb'],
        'pci': ['lspci', '-nnk'],
        'bluetooth': ['bluetoothctl', 'devices', 'Connected'],
    }.items():
        if not shutil.which(command[0]):
            report[key] = {'error': f'{command[0]} unavailable'}
            continue
        result = subprocess.run(command, text=True, capture_output=True)
        report[key] = {'output': result.stdout, 'error': result.stderr,
                       'status': result.returncode}
    ROOT.mkdir(parents=True, exist_ok=True)
    path = ROOT / 'inventory.json'
    previous = path.read_text() if path.exists() else None
    content = json.dumps(report, ensure_ascii=False, indent=2) + '\n'
    if previous and previous != content:
        (ROOT / 'inventory.previous.json').write_text(previous)
    path.write_text(content)
    print(content)
    print(f'Inventário salvo em {path}')


def choose(items, label):
    if not items:
        raise ValueError('Nenhum dispositivo encontrado.')
    for i, item in enumerate(items, 1):
        print(f'{i}: {item[label]}')
    value = int(input('Dispositivo (número): '))
    if not 1 <= value <= len(items):
        raise ValueError('Dispositivo inválido.')
    return items[value - 1]


def number(prompt, minimum, maximum):
    value = float(input(prompt))
    if not math.isfinite(value) or not minimum <= value <= maximum:
        raise ValueError(f'Valor deve estar entre {minimum} e {maximum}.')
    return value


def apply_settings(settings):
    ROOT.mkdir(parents=True, exist_ok=True)
    path = ROOT / 'devices.lua'
    state = ROOT / 'settings.json'
    old = path.read_bytes() if path.exists() else None
    lines = ['-- Generated by calibrate-devices; settings in settings.json.']
    # JSON string literals are valid Lua strings for ordinary hardware names.
    # Reject control characters to avoid JSON-only Unicode escape syntax.
    for name, options in settings['monitors'].items():
        lines.append('hl.monitor({ output = ' + lua_string(name)
                     + ', mode = ' + lua_string(options['mode'])
                     + ', position = "auto", scale = ' + str(options['scale']) + ' })')
    for name, options in settings['pointers'].items():
        lines.append('hl.device({ name = ' + lua_string(name)
                     + ', sensitivity = ' + str(options['sensitivity'])
                     + ', natural_scroll = ' + str(options['natural_scroll']).lower() + ' })')
    if old is not None:
        path.with_suffix('.lua.bak').write_bytes(old)
    path.write_text('\n'.join(lines) + '\n')
    confirmed = False
    try:
        run('hyprctl', 'reload')
        result = subprocess.run(['hyprctl', 'configerrors'], text=True,
                                capture_output=True, check=True)
        if result.stdout.strip():
            raise ValueError(result.stdout)
        print('Manter ajustes? Digite s em até 15 segundos; caso contrário serão revertidos.', flush=True)
        if select.select([sys.stdin], [], [], 15)[0]:
            confirmed = input().strip().lower() == 's'
        if confirmed:
            state.write_text(json.dumps(settings, ensure_ascii=False, indent=2) + '\n')
    finally:
        if not confirmed:
            if old is None:
                path.unlink(missing_ok=True)
            else:
                path.write_bytes(old)
            run('hyprctl', 'reload')
            print('Ajustes revertidos.')


def lua_string(value):
    if any(ord(c) < 32 or ord(c) == 127 for c in value):
        raise ValueError('Nome de dispositivo contém caracteres de controle.')
    return json.dumps(value, ensure_ascii=False)


def configure(kind):
    path = ROOT / 'settings.json'
    settings = json.loads(path.read_text()) if path.exists() else {'monitors': {}, 'pointers': {}}
    if kind == 'monitor':
        device = choose(query('hyprctl', 'monitors', 'all', '-j'), 'name')
        modes = device.get('availableModes', [])
        print('Modos anunciados:', ', '.join(modes))
        mode = input('Modo (Enter = preferred): ').strip() or 'preferred'
        if mode != 'preferred' and mode not in modes:
            raise ValueError('Escolha um modo anunciado pelo monitor.')
        scale = number('Escala (1 a 4): ', 1, 4)
        settings['monitors'][device['name']] = {'mode': mode, 'scale': scale}
    else:
        device = choose(query('hyprctl', 'devices', '-j').get('mice', []), 'name')
        sensitivity = number('Sensibilidade (-1 a 1; 0 = padrão): ', -1, 1)
        natural = input('Rolagem natural? [s/N]: ').strip().lower() == 's'
        settings['pointers'][device['name']] = {'sensitivity': sensitivity, 'natural_scroll': natural}
    apply_settings(settings)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--scan', action='store_true', help='save inventory without changing hardware')
    args = parser.parse_args()
    if args.scan:
        inventory()
        return
    if not sys.stdin.isatty():
        parser.error('Execute em um terminal, ou use --scan.')
    print('Conecte os dispositivos que deseja ajustar. Repita após conectar novos dispositivos.')
    while True:
        print('\n1 Inventário completo\n2 Monitor (modo e escala)\n3 Mouse/touchpad\n'
              '4 Áudio/microfone\n5 Webcam\n6 Bluetooth\n0 Sair')
        choice = input('Opção: ').strip()
        try:
            if choice == '0':
                return
            if choice == '1':
                inventory()
            elif choice in ('2', '3'):
                configure('monitor' if choice == '2' else 'pointer')
            elif choice == '4':
                print('Escolha entrada/saída, perfil e ganho no pavucontrol. Fale e confira o medidor; evite saturação.')
                run('pavucontrol')
            elif choice == '5':
                print('Escolha a câmera e confira foco, exposição, balanço de branco e formatos.\n'
                      'Os controles dependem da câmera; confira a persistência após reconectar.')
                run('qv4l2')
            elif choice == '6':
                run('blueman-manager')
        except (ValueError, OSError, subprocess.CalledProcessError) as error:
            print(f'Falha: {error}', file=sys.stderr)


if __name__ == '__main__':
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print('\nCancelado.')
