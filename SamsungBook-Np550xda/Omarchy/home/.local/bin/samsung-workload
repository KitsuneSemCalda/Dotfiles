#!/usr/bin/env python3
"""Request a temporary performance profile for an explicit foreground workload."""
import os
from pathlib import Path
import sys


def command_for(arguments, power_root=Path('/sys/class/power_supply')):
    if not arguments or arguments[0] not in ('gaming', 'content') or len(arguments) < 2:
        raise ValueError('Usage: samsung-workload gaming|content COMMAND [ARG ...]')
    mode, *command = arguments
    if command[0] == '--':
        command = command[1:]
    if not command:
        raise ValueError('A foreground command is required')
    online = any((p / 'type').read_text().strip() == 'Mains'
                 and (p / 'online').read_text().strip() == '1'
                 for p in power_root.iterdir() if (p / 'type').exists() and (p / 'online').exists())
    if not online:
        return command
    return ['powerprofilesctl', 'launch', '--profile', 'performance',
            '--reason', f'Samsung {mode} foreground workload',
            '--appid', 'dotfiles.samsung-workload', '--', *command]


def main():
    if Path('/sys/class/dmi/id/board_name').read_text().strip() != 'NP550XDA-KF2BR':
        raise SystemExit('Unsupported board')
    try:
        command = command_for(sys.argv[1:])
    except ValueError as error:
        raise SystemExit(str(error))
    os.execvp(command[0], command)


if __name__ == '__main__':
    main()
