#!/usr/bin/env bash
set -euo pipefail

dry_run=0
list=0
case ${1:-} in
  --dry-run) dry_run=1 ;;
  --list) list=1 ;;
  '') ;;
  *) echo 'Usage: home-dropbox-monthly [--dry-run|--list]' >&2; exit 2 ;;
esac
(( $# <= 1 )) || exit 2

home=$(realpath -e -- "$HOME")
dropbox=$(realpath -e -- "${HOME_BACKUP_DROPBOX_DIR:-$HOME/Dropbox}")
[[ $dropbox == "$home"/* ]] || { echo 'Dropbox must be inside HOME' >&2; exit 1; }
state="${XDG_STATE_HOME:-$HOME/.local/state}/home-dropbox-backup"
state=$(realpath -m -- "$state")
[[ $state != "$dropbox" && $state != "$dropbox"/* ]] || { echo 'Backup state must be outside Dropbox' >&2; exit 1; }
root="$state/archives/home"
current="$state/current"
cloud_root="$dropbox/Backups/SamsungBook-Np550xda/Omarchy"
includes="${HOME_BACKUP_CLOUD_INCLUDES_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/home-dropbox-backup/cloud-includes}"
helper="$(dirname -- "$0")/backup-zip"
date=${HOME_BACKUP_DATE:-${HOME_BACKUP_MONTH:+$HOME_BACKUP_MONTH-01}}
date=${date:-$(date +%F)}
[[ $date =~ ^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$ ]] \
  && [[ $(date -d "$date" +%F) == "$date" ]] || { echo 'Invalid backup date' >&2; exit 2; }
year=${date:0:4}
month=${date:0:7}

if ((list)); then
  [[ ! -d $root ]] || find "$root" -maxdepth 2 -type f -name '*.zip' -printf '%P\n' | sort
  exit 0
fi
[[ -d $current ]] || { echo 'Run home-dropbox-backup before creating a monthly ZIP' >&2; exit 1; }
umask 077
mkdir -p -- "$state/work"
export TMPDIR="$state/work"
exec 9>"$state/lock"
flock -w 3600 9 || { echo 'Timed out waiting for local home synchronization' >&2; exit 1; }

if ((dry_run)); then
  echo "Would migrate old cloud ZIPs locally, archive $root/$year/$date.zip and publish essentials within the total Dropbox budget"
  exit 0
fi
for kind in home btrfs; do
  local_root=$(realpath -m -- "$state/archives/$kind")
  [[ $local_root != "$dropbox" && $local_root != "$dropbox"/* ]] || { echo 'Local archives must be outside Dropbox' >&2; exit 1; }
  python3 "$helper" relocate "$cloud_root/$kind" "$state/archives/$kind"
done
python3 "$helper" consolidate "$root" --year "$year"
shopt -s nullglob
existing=("$root/$year/$month"-??.zip)
if ((${#existing[@]})); then
  for archive in "${existing[@]}"; do python3 "$helper" verify "$archive"; done
  echo "Local monthly ZIP already verified: ${existing[0]}"
fi
for marker in last-partial last-conflicts; do
  [[ ! -f $state/$marker ]] || { echo "Incomplete home synchronization ($marker); retry later" >&2; exit 1; }
done
[[ -f $state/last-success ]] || { echo 'No completed local home synchronization' >&2; exit 1; }
synced_at=$(python3 "$helper" synced-at "$state/last-success")
reserve=${HOME_BACKUP_MIN_FREE_GIB:-10}
[[ $reserve =~ ^[0-9]+$ ]] || exit 2
available=$(df -Pk -- "$dropbox" | awk 'NR == 2 {print $4}')
size=$(du -sk -- "$current" | awk '{print $1}')
((available >= size * 2 + reserve * 1024 * 1024)) || { echo 'Insufficient space for ZIP staging and reserve' >&2; exit 1; }
if ((!${#existing[@]})); then
  python3 "$helper" pack "$current" "$root/$year/$date.zip" --synced-at "$synced_at"
fi
python3 "$helper" cloud "$current" "$dropbox" --includes "$includes" --synced-at "$synced_at"
