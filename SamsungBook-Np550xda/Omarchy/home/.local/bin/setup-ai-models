#!/usr/bin/env python3
"""Keep model storage under ~/.ai/models without copying weights."""
from pathlib import Path


def setup(home):
    root = home / ".ai" / "models"
    pairs = [
        (home / ".lmstudio/models", root / "lmstudio"),
        (home / ".local/share/inferctl/comfyui/models", root / "comfyui"),
    ]
    # Refuse ambiguous layouts before moving any data.
    for source, destination in pairs:
        if source.is_symlink():
            if source.resolve() != destination.resolve() or not destination.is_dir():
                raise SystemExit(f"Unexpected or broken model link: {source}")
        elif source.exists():
            if not source.is_dir() or destination.exists():
                raise SystemExit(f"Conflicting model paths: {source} and {destination}")
    root.mkdir(parents=True, exist_ok=True)
    for source, destination in pairs:
        if not source.is_symlink():
            source.parent.mkdir(parents=True, exist_ok=True)
            if source.exists():
                source.rename(destination)
            else:
                destination.mkdir(parents=True, exist_ok=True)
            source.symlink_to(destination, target_is_directory=True)
        print(f"{source} -> {destination}")


if __name__ == "__main__":
    setup(Path.home())
