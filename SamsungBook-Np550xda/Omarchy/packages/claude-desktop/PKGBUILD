pkgname=claude-desktop
pkgver=3.1623.0
pkgrel=1
pkgdesc='Official Claude Desktop Linux beta, repackaged from the local Debian file'
arch=('x86_64')
url='https://claude.com/download'
license=('custom')
options=('!strip' '!debug')
depends=('at-spi2-core' 'glibc' 'gtk3' 'libdrm' 'libnotify' 'libsecret' 'libxtst' 'mesa' 'nss' 'pipewire' 'util-linux' 'xdg-desktop-portal' 'xdg-utils')
optdepends=('xdg-desktop-portal-gtk: desktop integration under Hyprland' 'gnome-keyring: secret storage' 'qemu-system-x86: Cowork virtualization' 'edk2-ovmf: Cowork UEFI firmware')
source=('claude-desktop_amd64.deb')
noextract=('claude-desktop_amd64.deb')
sha256sums=('d39e1d9a570f1e517f158479f5a1d903b9a74d1ef3f279362002dcad375e33cf')

package() {
  bsdtar -xOf "$srcdir/claude-desktop_amd64.deb" data.tar.xz | tar --no-same-owner -xJf - -C "$pkgdir"
}
